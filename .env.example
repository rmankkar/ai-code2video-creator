# NVIDIA NIM Configuration
# Get your API key from: https://build.nvidia.com/explore/discover
# Sign in, select a model (e.g., nvidia/nemotron-3-ultra-550b-a55b), click "Get API Key"

NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_NIM_API_KEY=your_nvapi_key_here

# Video Configuration
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_DURATION_SECONDS=20

# TTS Configuration (macOS say command)
TTS_VOICE=Samantha
TTS_RATE=200

# Output Directories
GENERATED_DIR=src/generated
AUDIO_DIR=public/audio

# Google Drive Configuration
# Auth type: oauth2 (user) or service_account (CI/CD)
GOOGLE_DRIVE_AUTH_TYPE=oauth2
GOOGLE_DRIVE_ENABLED=true

# OAuth2 Configuration (for user authentication)
# 1. Create OAuth 2.0 credentials in Google Cloud Console
# 2. Run the OAuth2 setup to get refresh token (see README)
GOOGLE_DRIVE_CLIENT_ID=your_client_id_here
GOOGLE_DRIVE_CLIENT_SECRET=your_client_secret_here
GOOGLE_DRIVE_REFRESH_TOKEN=your_refresh_token_here
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/oauth2callback

# Service Account Configuration (alternative to OAuth2)
# GOOGLE_DRIVE_SERVICE_ACCOUNT_KEY_PATH=./google-service-account.json
# GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com

# Parent folder in Google Drive (where topic folders will be created)
# Get folder ID from URL: https://drive.google.com/drive/folders/FOLDER_ID_HERE
GOOGLE_DRIVE_PARENT_FOLDER_ID=your_parent_folder_id_here
# Alternative: parent folder name (will be resolved to ID)
# GOOGLE_DRIVE_PARENT_FOLDER_NAME=ai-code2video-output